complete -c auto-tlp -s p -l profile -x -a 'balanced performance battery' -d 'Tuning profile'
complete -c auto-tlp -l start-thresh -x -d 'Battery start-charge threshold (0-99)'
complete -c auto-tlp -l stop-thresh -x -d 'Battery stop-charge threshold (1-100)'
complete -c auto-tlp -s o -l output -r -F -d 'Write config to FILE'
complete -c auto-tlp -l install -d 'Write /etc/tlp.d/99-auto-tlp.conf (needs root)'
complete -c auto-tlp -s r -l report -d 'Print the detected hardware report'
complete -c auto-tlp -s v -l verbose -d 'With --report: list all PCI/USB devices'
complete -c auto-tlp -l terse -d 'Omit explanatory comments'
complete -c auto-tlp -l only -x -a 'general cpu platform graphics storage pcie radios usb audio kernel battery' -d 'Only these sections (comma separated)'
complete -c auto-tlp -l skip -x -a 'general cpu platform graphics storage pcie radios usb audio kernel battery' -d 'Leave these sections out'
complete -c auto-tlp -l format -x -a 'conf nix json' -d 'Output format'
complete -c auto-tlp -l uninstall -d 'Remove /etc/tlp.d/99-auto-tlp.conf (needs root)'
complete -c auto-tlp -l apply -d 'Run tlp start after --install/--uninstall'
complete -c auto-tlp -l diff -d 'Compare with the installed config (exit 1 if different)'
complete -c auto-tlp -l against -r -F -d 'With --diff: compare with FILE'
complete -c auto-tlp -l sysroot -r -a '(__fish_complete_directories)' -d 'Scan a directory tree instead of the live system'
complete -c auto-tlp -l tlp-version -x -d 'Generate for this TLP version (>=1.11 = new key names)'
complete -c auto-tlp -l demo -d 'Use a built-in sample laptop instead of scanning'
complete -c auto-tlp -s h -l help -d 'Show help'
complete -c auto-tlp -s V -l version -d 'Show version'
